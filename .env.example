# Cloudflare Workers で動かす。値は本番では `wrangler secret put <NAME>`、
# ローカル（next dev / wrangler dev）では .dev.vars に書く（.dev.vars.example を参照）。
# データベースは wrangler.jsonc の D1 バインディング（DB）なので、ここには書かない。

# YouTube Data API (optional - YouTube search is disabled without this)
YOUTUBE_DATA_API_KEY=your-youtube-api-key

# Anthropic API (optional - pronunciation feedback falls back to basic diff without this)
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- /api/v1 (iOS) ---
# アクセストークン(HS256)の署名鍵。`openssl rand -base64 48` などで作る（32文字以上）
AUTH_SECRET=generate-a-long-random-string
# Sign in with Apple: iOSアプリの Bundle ID
APPLE_CLIENT_ID=com.example.shadowing
# 退会時の Apple 連携の失効に使う（Apple Developer で作る Sign in with Apple のキー）
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Google ログイン: 受け付ける OAuth クライアントID（iOS 用・Web 用をカンマ区切り）
GOOGLE_CLIENT_IDS=xxxx-ios.apps.googleusercontent.com
# App Store 審査用（審査員はメールを受け取れないので、このアドレスだけ固定コードで通す）
AUTH_REVIEW_EMAIL=review@shadowing.example.com
AUTH_REVIEW_CODE=000000
# パスキー・メール送信元は wrangler.jsonc の vars（PASSKEY_RP_ID / PASSKEY_RP_NAME / EMAIL_FROM）
# /api/v1/cron/collect の認証。Cloudflare の Cron Trigger（worker.ts の scheduled）がこれを付けて呼ぶ
CRON_SECRET=generate-a-long-random-string
